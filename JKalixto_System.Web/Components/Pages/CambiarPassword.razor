@page "/cambiar-password"

<PageTitle>Cambiar contraseña — JKalixto</PageTitle>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px;">
    <div class="card" style="width:100%; max-width:380px; padding:28px 26px;">
        <div style="display:flex; flex-direction:column; align-items:center; margin-bottom:20px;">
            <div class="app-logo" style="width:56px; height:56px; border-radius:16px; margin-bottom:10px; background:transparent;">
                <img src="/images/logo-transparente.png" alt="HJK" width="56" height="56" style="object-fit:contain;" />
            </div>
            <strong style="font-size:1.1rem;">Cambiar contraseña</strong>
            @if (Obligatorio)
            {
                <span class="page-subtitle" style="margin-top:2px; text-align:center;">Tu cuenta todavía usa una contraseña de prueba — elegí una propia antes de seguir.</span>
            }
            else
            {
                <span class="page-subtitle" style="margin-top:2px;">Elegí tu nueva contraseña</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorParam))
        {
            <div class="caja-error"><p>@ErrorParam</p></div>
        }

        <form method="post" action="/account/cambiar-password">
            @if (!Obligatorio)
            {
                <div class="form-grupo">
                    <label>Contraseña actual</label>
                    <input type="password" name="actual" autocomplete="current-password" required />
                </div>
            }

            <div class="form-grupo">
                <label>Contraseña nueva</label>
                <input type="password" name="nueva" autocomplete="new-password" minlength="8" required />
                <span class="page-subtitle" style="margin-top:2px;">Al menos 8 caracteres, con una letra y un número.</span>
            </div>

            <div class="form-grupo">
                <label>Confirmar contraseña nueva</label>
                <input type="password" name="confirmacion" autocomplete="new-password" minlength="8" required />
            </div>

            <button class="btn btn-bloque" type="submit" style="margin-top:6px;">Guardar contraseña</button>
        </form>

        @if (!Obligatorio)
        {
            <a href="/recepcion" class="volver" style="display:block; text-align:center; margin-top:16px;">Cancelar y volver</a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorParam { get; set; }

    [SupplyParameterFromQuery(Name = "obligatorio")]
    public string? ObligatorioParam { get; set; }

    private bool Obligatorio => ObligatorioParam == "1";
}
