@page "/registro-huespedes"
@using JKalixto_System.Application.Services
@inject IRegistroHuespedesService RegistroHuespedesService

<PageTitle>Registro de Huéspedes</PageTitle>

<div style="padding:1.5rem;">
    <h1>Registro de Huéspedes</h1>
    <p style="color:#9aa0a6;">Registro exigido por MINCETUR (D.S. N° 001-2015-MINCETUR / D.S. N° 005-2021-MINCETUR).</p>

    @if (_error is not null)
    {
        <p style="color:#f28b82;">@_error</p>
    }

    <input placeholder="Buscar por nombre o documento…"
           style="background:#292a2d; border:1px solid #3c4043; border-radius:6px; padding:8px; color:#e8eaed; width:100%; max-width:400px; margin-bottom:16px;"
           value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />

    @if (_cargando)
    {
        <p>Cargando…</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
                <thead>
                    <tr style="text-align:left; border-bottom:1px solid #3c4043;">
                        <th style="padding:6px;">Hab.</th>
                        <th style="padding:6px;">Nombre</th>
                        <th style="padding:6px;">Documento</th>
                        <th style="padding:6px;">Sexo</th>
                        <th style="padding:6px;">Nac. / Nacionalidad</th>
                        <th style="padding:6px;">Procedencia</th>
                        <th style="padding:6px;">Motivo</th>
                        <th style="padding:6px;">Tarifa</th>
                        <th style="padding:6px;">Ingreso</th>
                        <th style="padding:6px;">Salida</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Filtrados())
                    {
                        <tr style="border-bottom:1px solid #292a2d;">
                            <td style="padding:6px;">@r.NumeroHabitacion</td>
                            <td style="padding:6px;">@r.NombreCompleto</td>
                            <td style="padding:6px;">@r.EtiquetaTipoDocumento @r.NumeroDocumento</td>
                            <td style="padding:6px;">@r.EtiquetaSexo</td>
                            <td style="padding:6px;">@r.FechaNacimientoTexto / @r.Nacionalidad</td>
                            <td style="padding:6px;">@r.LugarResidencia</td>
                            <td style="padding:6px;">@r.EtiquetaMotivoViaje</td>
                            <td style="padding:6px;">@r.Tarifa.ToString("C")</td>
                            <td style="padding:6px;">@r.FechaIngresoTexto</td>
                            <td style="padding:6px;">@r.FechaSalidaTexto</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<RegistroHuespedDto> _registros = new();
    private bool _cargando = true;
    private string? _error;
    private string _textoBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _registros = await RegistroHuespedesService.ObtenerRegistroAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el registro: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private IEnumerable<RegistroHuespedDto> Filtrados()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            return _registros;
        }

        var texto = _textoBusqueda.Trim();
        return _registros.Where(r =>
            r.NombreCompleto.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            r.NumeroDocumento.Contains(texto, StringComparison.OrdinalIgnoreCase));
    }
}
