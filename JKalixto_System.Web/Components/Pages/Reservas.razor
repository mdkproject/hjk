@page "/reservas"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@using JKalixto_System.Web.Services
@inject IReservaService ReservaService
@inject IHabitacionService HabitacionService
@inject INotificadorCambios Notificador
@inject SesionWebService Sesion
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>Reservas</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1>Reservas</h1>
            <p class="page-subtitle">Próximas reservas y disponibilidad de hoy</p>
        </div>
        <div class="page-actions">
            <button class="btn" @onclick='() => Navegacion.NavigateTo("/reservas/nuevo")'>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Nueva Reserva
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="caja-error"><p>@_error</p></div>
    }

    <div style="display:flex; gap:24px; flex-wrap:wrap;">
        <div style="flex:2; min-width:320px;">
            <div class="search-input" style="margin-bottom:14px;">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                <input placeholder="Buscar por huésped, habitación o celular…" value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />
            </div>

            @if (_cargandoReservas)
            {
                <p class="empty-state">Cargando reservas…</p>
            }
            else
            {
                @foreach (var reserva in ReservasFiltradas())
                {
                    <div class="card card-clickable" style="margin-bottom:8px;" @onclick="() => _reservaSeleccionada = reserva">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <strong>Hab. @reserva.NumeroHabitacion — @reserva.EtiquetaTipoHabitacion</strong>
                            <span class="badge" style="background:@ColorParaEstadoReserva(reserva.Estado); color:white;">@EtiquetaEstadoReserva(reserva.Estado)</span>
                        </div>
                        <div style="margin-top:2px;">@reserva.NombreCliente — @reserva.Celular</div>
                        <div style="color:var(--text-secondary); font-size:0.85rem;">@reserva.FechaInicio.ToString("dd/MM/yyyy") → @reserva.FechaFin.ToString("dd/MM/yyyy")</div>
                    </div>
                }
            }
        </div>

        <div class="card" style="flex:1; min-width:280px; align-self:flex-start;">
            <h3 style="margin-top:0;">Disponibilidad de hoy</h3>
            <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:12px;">
                <select class="filtro-select" @bind="_filtroPiso">
                    <option value="0">Todos los pisos</option>
                    <option value="1">Piso 1</option>
                    <option value="2">Piso 2</option>
                    <option value="3">Piso 3</option>
                    <option value="4">Piso 4</option>
                </select>
                <select class="filtro-select" @bind="_filtroEstado">
                    <option value="">Todos los estados</option>
                    @foreach (var estado in Enum.GetValues<EstadoHabitacion>())
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>

            @if (_cargandoHabitaciones)
            {
                <p class="empty-state">Cargando…</p>
            }
            else
            {
                @foreach (var h in HabitacionesFiltradas())
                {
                    <div style="border-bottom:1px solid var(--border); padding:7px 2px; display:flex; justify-content:space-between; font-size:0.9rem;">
                        <span>Hab. @h.Numero</span>
                        <span style="color:var(--text-secondary);">@h.EtiquetaEstado</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (_reservaSeleccionada is { } r)
{
    <ModalBase Titulo="@($"Hab. {r.NumeroHabitacion} — {r.NombreCliente}")" OnCerrar="() => _reservaSeleccionada = null">
        <p>Documento: @r.NumeroDocumento</p>
        <p>Celular: @r.Celular</p>
        <p>@r.FechaInicio.ToString("dd/MM/yyyy") → @r.FechaFin.ToString("dd/MM/yyyy")</p>
        @if (!string.IsNullOrWhiteSpace(r.Observaciones))
        {
            <p>Observaciones: @r.Observaciones</p>
        }

        @if (r.Estado == EstadoReserva.Confirmada)
        {
            <button class="btn btn-bloque" @onclick="() => ConvertirEnCheckInAsync(r)">Hacer Check-in ahora</button>
            <button class="btn btn-peligro btn-bloque" @onclick="() => CancelarAsync(r)">Cancelar reserva</button>
        }
    </ModalBase>
}

@code {
    private List<ReservaCardDto> _reservas = new();
    private List<HabitacionCardDto> _habitaciones = new();
    private bool _cargandoReservas = true;
    private bool _cargandoHabitaciones = true;
    private string? _error;
    private string _textoBusqueda = string.Empty;
    private int _filtroPiso;
    private string _filtroEstado = string.Empty;
    private ReservaCardDto? _reservaSeleccionada;

    protected override async Task OnInitializedAsync()
    {
        await CargarReservasAsync();
        await CargarHabitacionesAsync();
        Notificador.CambioDetectado += OnCambioDetectado;
    }

    private async Task CargarReservasAsync()
    {
        try
        {
            _reservas = await ReservaService.ObtenerProximasAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar las reservas: {ex.Message}";
        }
        finally
        {
            _cargandoReservas = false;
        }
    }

    private async Task CargarHabitacionesAsync()
    {
        try
        {
            _habitaciones = await HabitacionService.ObtenerTodasAsync();
        }
        finally
        {
            _cargandoHabitaciones = false;
        }
    }

    private IEnumerable<ReservaCardDto> ReservasFiltradas()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            return _reservas;
        }

        var texto = _textoBusqueda.Trim();
        return _reservas.Where(r =>
            r.NombreCliente.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            r.NumeroHabitacion.ToString().Contains(texto) ||
            r.Celular.Contains(texto, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<HabitacionCardDto> HabitacionesFiltradas()
    {
        var query = _habitaciones.AsEnumerable();
        if (_filtroPiso != 0)
        {
            query = query.Where(h => h.Piso == _filtroPiso);
        }

        if (!string.IsNullOrEmpty(_filtroEstado) && Enum.TryParse<EstadoHabitacion>(_filtroEstado, out var estado))
        {
            query = query.Where(h => h.Estado == estado);
        }

        return query.OrderBy(h => h.Numero);
    }

    private static string EtiquetaEstadoReserva(EstadoReserva estado) => estado switch
    {
        EstadoReserva.Confirmada => "Confirmada",
        EstadoReserva.CheckInRealizado => "Check-in realizado",
        EstadoReserva.Cancelada => "Cancelada",
        _ => estado.ToString()
    };

    private static string ColorParaEstadoReserva(EstadoReserva estado) => estado switch
    {
        EstadoReserva.Confirmada => "#7C3AED",
        EstadoReserva.CheckInRealizado => "#2563EB",
        EstadoReserva.Cancelada => "#6B7280",
        _ => "#6B7280"
    };

    private async Task ConvertirEnCheckInAsync(ReservaCardDto r)
    {
        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await ReservaService.ConvertirEnCheckInAsync(r.ReservaId, usuario.Id);
            _reservaSeleccionada = null;
            await CargarReservasAsync();
            await CargarHabitacionesAsync();
            Notificador.Avisar("habitaciones");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo hacer el check-in: {ex.Message}";
        }
    }

    private async Task CancelarAsync(ReservaCardDto r)
    {
        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await ReservaService.CancelarReservaAsync(r.ReservaId, usuario.Id);
            _reservaSeleccionada = null;
            await CargarReservasAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cancelar la reserva: {ex.Message}";
        }
    }

    private async void OnCambioDetectado(string area)
    {
        if (area != "habitaciones")
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await CargarHabitacionesAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notificador.CambioDetectado -= OnCambioDetectado;
    }
}
