@page "/calendario"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@inject ICalendarioService CalendarioService
@inject NavigationManager Navegacion

<PageTitle>Calendario</PageTitle>

<div class="page">
    <div class="page-header"><h1>Calendario</h1></div>

    @if (_error is not null)
    {
        <div class="caja-error"><p>@_error</p></div>
    }

    <div class="filtros-fila">
        <button class="btn btn-secundario" @onclick="MesAnteriorAsync">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <strong style="min-width:130px; text-align:center;">@(_calendario?.NombreMesTexto ?? "")</strong>
        <button class="btn btn-secundario" @onclick="MesSiguienteAsync">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <button class="btn btn-secundario" @onclick="IrAHoyAsync">Hoy</button>

        <select class="filtro-select" @bind="_filtroPiso">
            <option value="0">Todos los pisos</option>
            <option value="1">Piso 1</option>
            <option value="2">Piso 2</option>
            <option value="3">Piso 3</option>
            <option value="4">Piso 4</option>
        </select>

        <div class="search-input" style="min-width:240px;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <input placeholder="Buscar habitación o huésped…" value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />
        </div>
    </div>

    @if (_calendario is null)
    {
        <p class="empty-state">Cargando…</p>
    }
    else
    {
        <div class="table-wrap" style="overflow-x:auto;">
            <table style="border-collapse:collapse; font-size:0.8rem;">
                <thead>
                    <tr>
                        <th style="position:sticky; left:0; background:var(--surface); padding:6px 10px; border-bottom:1px solid var(--border); border-right:1px solid var(--border); color:var(--text-muted); font-size:0.72rem; text-transform:uppercase;">Hab.</th>
                        @foreach (var dia in _calendario.Dias)
                        {
                            <th style="padding:4px 2px; border-bottom:1px solid var(--border); min-width:26px; color:var(--text-muted); font-weight:600;">@dia</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var columna in ColumnasFiltradas())
                    {
                        <tr>
                            <td style="position:sticky; left:0; background:var(--surface); padding:4px 10px; border-right:1px solid var(--border); border-bottom:1px solid var(--border); font-weight:600;">@columna.Numero</td>
                            @foreach (var celda in columna.Celdas)
                            {
                                <td title="@(celda.NombreCliente ?? "")"
                                    style="padding:0; border-bottom:1px solid var(--border); background:@ColorParaCelda(celda.Estado); width:26px; height:24px; cursor:pointer; @(celda.EsHoy ? "outline:2px solid white; outline-offset:-2px;" : "")"
                                    @onclick="() => AbrirCelda(columna, celda)"></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="margin-top:14px; display:flex; gap:16px; font-size:0.85rem; color:var(--text-secondary);">
            <span><span style="display:inline-block; width:11px; height:11px; border-radius:3px; background:#16A34A; margin-right:5px; vertical-align:-1px;"></span>Disponible</span>
            <span><span style="display:inline-block; width:11px; height:11px; border-radius:3px; background:#2563EB; margin-right:5px; vertical-align:-1px;"></span>Ocupada</span>
            <span><span style="display:inline-block; width:11px; height:11px; border-radius:3px; background:#7C3AED; margin-right:5px; vertical-align:-1px;"></span>Reservada</span>
            <span><span style="display:inline-block; width:11px; height:11px; border-radius:3px; background:#DC2626; margin-right:5px; vertical-align:-1px;"></span>Mantenimiento</span>
        </div>
    }
</div>

@if (_celdaSeleccionada is { } info)
{
    <ModalBase Titulo="@($"Habitación {info.columna.Numero} — día {info.celda.Dia}")" OnCerrar="() => _celdaSeleccionada = null">
        <p>Estado: @info.celda.Estado</p>
        @if (!string.IsNullOrWhiteSpace(info.celda.NombreCliente))
        {
            <p>Cliente: @info.celda.NombreCliente</p>
        }

        @if (info.celda.Estado == EstadoCeldaCalendario.Disponible)
        {
            <button class="btn btn-bloque" @onclick='() => Navegacion.NavigateTo("/reservas/nuevo")'>Reservar esta habitación</button>
        }
    </ModalBase>
}

@code {
    private CalendarioMensualDto? _calendario;
    private string? _error;
    private int _anio = DateTime.Today.Year;
    private int _mes = DateTime.Today.Month;
    private int _filtroPiso;
    private string _textoBusqueda = string.Empty;
    private (ColumnaHabitacionCalendarioDto columna, CeldaCalendarioDto celda)? _celdaSeleccionada;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _error = null;
            _calendario = await CalendarioService.ObtenerCalendarioMensualAsync(_anio, _mes);
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el calendario: {ex.Message}";
        }
    }

    private async Task MesAnteriorAsync()
    {
        var fecha = new DateTime(_anio, _mes, 1).AddMonths(-1);
        _anio = fecha.Year;
        _mes = fecha.Month;
        await CargarAsync();
    }

    private async Task MesSiguienteAsync()
    {
        var fecha = new DateTime(_anio, _mes, 1).AddMonths(1);
        _anio = fecha.Year;
        _mes = fecha.Month;
        await CargarAsync();
    }

    private async Task IrAHoyAsync()
    {
        _anio = DateTime.Today.Year;
        _mes = DateTime.Today.Month;
        await CargarAsync();
    }

    private IEnumerable<ColumnaHabitacionCalendarioDto> ColumnasFiltradas()
    {
        if (_calendario is null)
        {
            return Enumerable.Empty<ColumnaHabitacionCalendarioDto>();
        }

        var query = _calendario.Columnas.AsEnumerable();
        if (_filtroPiso != 0)
        {
            query = query.Where(c => c.Piso == _filtroPiso);
        }

        if (!string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            var texto = _textoBusqueda.Trim();
            query = query.Where(c =>
                c.Numero.ToString().Contains(texto) ||
                c.Celdas.Any(cel => (cel.NombreCliente ?? string.Empty).Contains(texto, StringComparison.OrdinalIgnoreCase)));
        }

        return query.OrderBy(c => c.Numero);
    }

    private void AbrirCelda(ColumnaHabitacionCalendarioDto columna, CeldaCalendarioDto celda) => _celdaSeleccionada = (columna, celda);

    private static string ColorParaCelda(EstadoCeldaCalendario estado) => estado switch
    {
        EstadoCeldaCalendario.Disponible => "#16A34A",
        EstadoCeldaCalendario.Ocupada => "#2563EB",
        EstadoCeldaCalendario.Reservada => "#7C3AED",
        EstadoCeldaCalendario.Mantenimiento => "#DC2626",
        _ => "#6B7280"
    };
}
