@page "/gastos"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@using JKalixto_System.Web.Services
@inject IGastosService GastosService
@inject SesionWebService Sesion
@inject NavigationManager Navegacion

<PageTitle>Gastos</PageTitle>

<div style="padding:1.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <h1>Gastos</h1>
        <button class="btn" @onclick='() => Navegacion.NavigateTo("/gastos/nuevo")'>+ Nuevo Movimiento</button>
    </div>

    @if (_error is not null)
    {
        <p style="color:#f28b82;">@_error</p>
    }

    @if (_resumenCaja is not null)
    {
        <div style="display:flex; gap:12px; margin-bottom:16px; flex-wrap:wrap;">
            <div style="border:1px solid #3c4043; border-radius:8px; padding:10px; flex:1; min-width:200px;">
                Caja Chica Hotel — esperado (base @_resumenCaja.MontoBaseHotel.ToString("C")): <strong>@_resumenCaja.MontoEsperadoHotel.ToString("C")</strong>
            </div>
            <div style="border:1px solid #3c4043; border-radius:8px; padding:10px; flex:1; min-width:200px;">
                Caja Chica Sauna — esperado (base @_resumenCaja.MontoBaseSauna.ToString("C")): <strong>@_resumenCaja.MontoEsperadoSauna.ToString("C")</strong>
            </div>
        </div>
    }

    <input placeholder="Buscar por descripción o personal…"
           style="background:#292a2d; border:1px solid #3c4043; border-radius:6px; padding:8px; color:#e8eaed; width:100%; max-width:400px; margin-bottom:16px;"
           value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />

    @if (_cargando)
    {
        <p>Cargando…</p>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="text-align:left; border-bottom:1px solid #3c4043;">
                    <th style="padding:6px;">Hora</th>
                    <th style="padding:6px;">Tipo</th>
                    <th style="padding:6px;">Descripción</th>
                    <th style="padding:6px;">Cajero</th>
                    <th style="padding:6px;">Método</th>
                    <th style="padding:6px;">Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Filtrados())
                {
                    <tr style="border-bottom:1px solid #292a2d; cursor:pointer;" @onclick="() => ConfirmarEliminarAsync(m)">
                        <td style="padding:6px;">@m.FechaHora.ToString("HH:mm")</td>
                        <td style="padding:6px;">@m.OrigenCaja — @m.Categoria</td>
                        <td style="padding:6px;">@m.Descripcion</td>
                        <td style="padding:6px;">@m.UsuarioNombre</td>
                        <td style="padding:6px;">@m.MetodoPago</td>
                        <td style="padding:6px; color:@(m.Direccion == DireccionMovimiento.Ingreso ? "#81c995" : "#f28b82");">
                            @(m.Direccion == DireccionMovimiento.Ingreso ? "+" : "-")@m.Monto.ToString("C")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_paraEliminar is { } m2)
{
    <ModalBase Titulo="Eliminar movimiento" OnCerrar="() => _paraEliminar = null">
        <p>@m2.Descripcion — @m2.Monto.ToString("C")</p>
        <p>¿Confirmás que querés eliminar este movimiento? Esta acción requiere rol de Gerencia/Desarrollador.</p>
        <button class="btn btn-peligro btn-bloque" @onclick="EliminarAsync">Sí, eliminar</button>
    </ModalBase>
}

@code {
    private List<MovimientoCajaCardDto> _movimientos = new();
    private CajaChicaResumenDto? _resumenCaja;
    private bool _cargando = true;
    private string? _error;
    private string _textoBusqueda = string.Empty;
    private MovimientoCajaCardDto? _paraEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            _movimientos = await GastosService.ObtenerDelDiaAsync(DateTime.Today);
            _resumenCaja = await GastosService.ObtenerResumenCajaChicaAsync(DateTime.Today);
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar los movimientos: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private IEnumerable<MovimientoCajaCardDto> Filtrados()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            return _movimientos;
        }

        var texto = _textoBusqueda.Trim();
        return _movimientos.Where(m =>
            m.Descripcion.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            (m.PersonalRelacionado ?? string.Empty).Contains(texto, StringComparison.OrdinalIgnoreCase));
    }

    private void ConfirmarEliminarAsync(MovimientoCajaCardDto m) => _paraEliminar = m;

    private async Task EliminarAsync()
    {
        if (_paraEliminar is null)
        {
            return;
        }

        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await GastosService.EliminarMovimientoAsync(_paraEliminar.Id, usuario.Id);
            _paraEliminar = null;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo eliminar: {ex.Message}";
            _paraEliminar = null;
        }
    }
}
