@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Iniciar sesión — JKalixto</PageTitle>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px;">
    <div class="card" style="width:100%; max-width:360px; padding:28px 26px;">
        <div style="display:flex; flex-direction:column; align-items:center; margin-bottom:20px;">
            <div class="app-logo" style="width:64px; height:64px; border-radius:16px; margin-bottom:10px; background:transparent;">
                <img src="/images/logo-transparente.png" alt="HJK" width="64" height="64" style="object-fit:contain;" />
            </div>
            <strong style="font-size:1.1rem;">HKX — Hotel &amp; Sauna System</strong>
            <span class="page-subtitle" style="margin-top:2px;">Iniciá sesión para continuar</span>
        </div>

        @if (Error)
        {
            <div class="caja-error"><p>Usuario o contraseña incorrectos.</p></div>
        }

        <form method="post" action="/account/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="form-grupo">
                <label>Usuario</label>
                <input type="text" name="username" autocomplete="username" required />
            </div>

            <div class="form-grupo">
                <label>Contraseña</label>
                <input type="password" name="password" autocomplete="current-password" required />
            </div>

            <button class="btn btn-bloque" type="submit" style="margin-top:6px;">Ingresar</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorParam { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool Error => ErrorParam is not null;
}
