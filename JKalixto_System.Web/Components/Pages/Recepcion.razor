@page "/recepcion"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@using JKalixto_System.Web.Services
@inject IHabitacionService HabitacionService
@inject INotificadorCambios Notificador
@inject SesionWebService Sesion
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>Registro Hotel</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1>Registro Hotel</h1>
            <p class="page-subtitle">Tablero de habitaciones en tiempo real</p>
        </div>
        @if (_puedeFijarFecha)
        {
            <div class="page-actions">
                <button class="btn btn-secundario" @onclick="() => _vistaTarifas = true">Editar tarifas</button>
            </div>
        }
    </div>

    @if (_error is not null)
    {
        <div class="caja-error"><p>@_error</p></div>
    }

    @{
        var paraContar = HabitacionesPorPisoYTipo();
        var contDisponible = paraContar.Count(h => h.Estado == EstadoHabitacion.Disponible);
        var contOcupada = paraContar.Count(h => h.Estado == EstadoHabitacion.Ocupada);
        var contLimpieza = paraContar.Count(h => h.Estado == EstadoHabitacion.LimpiezaSalida);
        var contMantenimiento = paraContar.Count(h => h.Estado == EstadoHabitacion.Mantenimiento);
        var totalFiltrado = paraContar.Count;
        var pctOcupacion = totalFiltrado == 0 ? 0 : (int)Math.Round(100m * contOcupada / totalFiltrado);
    }

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Ocupación</div>
            <div class="kpi-value">@pctOcupacion%</div>
            <div style="color:var(--text-muted); font-size:0.78rem; margin-top:2px;">@contOcupada de @totalFiltrado habitaciones</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Disponibles</div>
            <div class="kpi-value" style="color:var(--ok);">@contDisponible</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">En limpieza</div>
            <div class="kpi-value" style="color:var(--warn);">@contLimpieza</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">En mantenimiento</div>
            <div class="kpi-value" style="color:var(--danger);">@contMantenimiento</div>
        </div>
    </div>

    <!--
        Filtros — mismo criterio que RecepcionViewModel.TextoBusqueda /
        FiltroPiso / FiltroTipo / FiltroEstado en MAUI, reimplementado acá
        porque esa ViewModel es específica de MAUI (capa de presentación, no
        compartida). El tablero se recalcula solo con cada tecla/selección,
        sin volver a pedir datos al servidor (ya los tenemos todos cargados).
        Chips de colores en vez de <select> — mismo patrón ya usado en
        Reservas/Calendario, para que las pestañas del día a día se vean
        consistentes entre sí.
    -->
    <div class="card" style="margin-bottom:20px;">
        <div class="search-input" style="margin-bottom:14px;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <input placeholder="Buscar por número, huésped, celular o documento…" value="@_textoBusqueda" @oninput="OnBuscarInput" />
        </div>

        <div class="filtro-grupo">
            <span class="filtro-grupo-label">Piso</span>
            <div class="filtro-chips">
                <button type="button" class="filtro-chip @(_filtroPiso == 0 ? "activo" : "")" @onclick="() => _filtroPiso = 0">Todos</button>
                <button type="button" class="filtro-chip @(_filtroPiso == 1 ? "activo" : "")" @onclick="() => _filtroPiso = 1">Piso 1</button>
                <button type="button" class="filtro-chip @(_filtroPiso == 2 ? "activo" : "")" @onclick="() => _filtroPiso = 2">Piso 2</button>
                <button type="button" class="filtro-chip @(_filtroPiso == 3 ? "activo" : "")" @onclick="() => _filtroPiso = 3">Piso 3</button>
                <button type="button" class="filtro-chip @(_filtroPiso == 4 ? "activo" : "")" @onclick="() => _filtroPiso = 4">Piso 4</button>
            </div>
        </div>

        <div class="filtro-grupo">
            <span class="filtro-grupo-label">Tipo</span>
            <div class="filtro-chips">
                <button type="button" class="filtro-chip @(_filtroTipo == "" ? "activo" : "")" @onclick='() => _filtroTipo = ""'>Todos</button>
                @foreach (var tipo in Enum.GetValues<TipoHabitacion>())
                {
                    <button type="button" class="filtro-chip @(_filtroTipo == tipo.ToString() ? "activo" : "")" @onclick="() => _filtroTipo = tipo.ToString()">@tipo</button>
                }
            </div>
        </div>

        <div class="filtro-grupo" style="margin-bottom:0;">
            <span class="filtro-grupo-label">Estado</span>
            <div class="filtro-chips">
                <button type="button" class="filtro-chip @(_filtroEstado == "" ? "activo" : "")" @onclick='() => _filtroEstado = ""'>Todos</button>
                <button type="button" class="filtro-chip filtro-chip-estado filtro-chip-disponible @(_filtroEstado == "Disponible" ? "activo" : "")" @onclick='() => _filtroEstado = "Disponible"'>Disponible (@contDisponible)</button>
                <button type="button" class="filtro-chip filtro-chip-estado filtro-chip-ocupada @(_filtroEstado == "Ocupada" ? "activo" : "")" @onclick='() => _filtroEstado = "Ocupada"'>Ocupada (@contOcupada)</button>
                <button type="button" class="filtro-chip filtro-chip-estado filtro-chip-limpieza @(_filtroEstado == "LimpiezaSalida" ? "activo" : "")" @onclick='() => _filtroEstado = "LimpiezaSalida"'>Limpieza (@contLimpieza)</button>
                <button type="button" class="filtro-chip filtro-chip-estado filtro-chip-mantenimiento @(_filtroEstado == "Mantenimiento" ? "activo" : "")" @onclick='() => _filtroEstado = "Mantenimiento"'>Mantenimiento (@contMantenimiento)</button>
            </div>
        </div>
    </div>

    @if (_cargando)
    {
        <p class="empty-state">Cargando habitaciones…</p>
    }
    else
    {
        var filtradas = HabitacionesFiltradas().ToList();
        @if (filtradas.Count == 0)
        {
            <p class="empty-state">Ninguna habitación coincide con el filtro/búsqueda actual.</p>
        }
        @foreach (var grupoPiso in filtradas.GroupBy(h => h.Piso).OrderBy(g => g.Key))
        {
            <div class="section-title">Piso @grupoPiso.Key</div>
            <div class="card-grid" style="margin-bottom:24px;">
                @foreach (var habitacion in grupoPiso.OrderBy(h => h.Numero))
                {
                    <div class="card card-clickable" style="border-left:3px solid @ColorParaClave(habitacion.ClaveColorEstado); width:220px;"
                         @onclick="() => AbrirMenuHabitacion(habitacion)">
                        <div style="display:flex; justify-content:space-between; align-items:start;">
                            <div>
                                <div style="color:var(--text-secondary); font-size:0.82rem;">@habitacion.EtiquetaTipo</div>
                                <span class="badge" style="background:@ColorParaClave(habitacion.ClaveColorEstado); color:@ContrasteParaClave(habitacion.ClaveColorEstado);">
                                    @habitacion.EtiquetaEstado
                                </span>
                                @if (habitacion.Estado == EstadoHabitacion.Ocupada)
                                {
                                    <div style="font-size:0.85rem; margin-top:6px; font-weight:600;">@habitacion.NombreHuesped</div>
                                    <div style="font-size:0.8rem; color:var(--text-secondary);">@habitacion.TotalAcumulado?.ToString("C")</div>
                                }
                                else if (habitacion.Estado == EstadoHabitacion.Mantenimiento && !string.IsNullOrWhiteSpace(habitacion.MotivoMantenimiento))
                                {
                                    <div style="font-size:0.8rem; color:var(--text-secondary); margin-top:6px;">@habitacion.MotivoMantenimiento</div>
                                }
                                else
                                {
                                    <div style="font-size:0.8rem; color:var(--text-secondary); margin-top:6px;">@habitacion.TarifaTexto</div>
                                }
                            </div>
                            <strong style="font-size:1.4rem;">@habitacion.Numero</strong>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@* ============================================================
   Modales de acción — un único "estado de diálogo" controla cuál se
   muestra. Mismos flujos que RecepcionPage/RecepcionViewModel en MAUI
   (ActionSheet/DisplayAlert/DisplayPrompt allá, modal simple acá). *@

@if (_habitacionSeleccionada is { } h)
{
    @switch (_vistaModal)
    {
        case VistaModal.MenuDisponible:
            <ModalBase Titulo='@($"Habitación {h.Numero} — {h.EtiquetaTipo} ({h.TarifaTexto})")' OnCerrar="CerrarModal">
                <button class="btn btn-bloque" @onclick='() => Navegacion.NavigateTo($"/checkin/{h.HabitacionId}")'>Hacer Check-in</button>
                <button class="btn btn-secundario btn-bloque" @onclick="() => _vistaModal = VistaModal.PromptMantenimiento">Enviar a Mantenimiento</button>
            </ModalBase>
            break;

        case VistaModal.PromptMantenimiento:
            <ModalBase Titulo="Motivo de mantenimiento" OnCerrar="CerrarModal">
                <p style="color:var(--text-secondary); font-size:0.85rem; margin-top:0;">Es obligatorio indicar un motivo (regla anti-fraude: evita pasar una habitación a mantenimiento sin justificación).</p>
                <div class="form-grupo">
                    <textarea style="min-height:70px;" placeholder="Ej: Aire acondicionado no enfría" @bind="_motivoMantenimiento" @bind:event="oninput"></textarea>
                </div>
                @if (_errorModal is not null)
                {
                    <p class="mensaje-error">@_errorModal</p>
                }
                <button class="btn btn-bloque" disabled="@_guardando" @onclick="() => ConfirmarIniciarMantenimientoAsync(h)">@(_guardando ? "Guardando…" : "Confirmar")</button>
            </ModalBase>
            break;

        case VistaModal.MenuOcupada:
            <ModalBase Titulo='@($"Hab. {h.Numero} — {h.NombreHuesped}")' OnCerrar="CerrarModal">
                <p style="color:var(--text-secondary); margin-top:0;">Total acumulado: @h.TotalAcumulado?.ToString("C")</p>
                <button class="btn btn-secundario btn-bloque" @onclick="() => _vistaModal = VistaModal.DetalleHuesped">Ver detalles del huésped</button>
                <button class="btn btn-bloque" @onclick="() => _vistaModal = VistaModal.ConfirmarCheckout">Hacer Check-out</button>
                <button class="btn btn-secundario btn-bloque" disabled="@_guardando" @onclick="() => SolicitarLimpiezaIntermediaAsync(h)">Solicitar limpieza intermedia</button>
            </ModalBase>
            break;

        case VistaModal.DetalleHuesped:
            <ModalBase Titulo="Detalles del huésped" OnCerrar="CerrarModal">
                <p><strong>Nombre:</strong> @h.NombreHuesped</p>
                <p><strong>@h.EtiquetaTipoDocumentoHuesped:</strong> @h.NumeroDocumentoHuesped</p>
                <p><strong>Celular:</strong> @h.CelularHuesped</p>
                <p><strong>Check-in:</strong> @h.FechaCheckInHuesped?.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Acompañantes:</strong> @h.AcompanantesTexto</p>
                <p><strong>Total acumulado:</strong> @h.TotalAcumulado?.ToString("C")</p>
            </ModalBase>
            break;

        case VistaModal.ConfirmarCheckout:
            <ModalBase Titulo="Confirmar Check-out" OnCerrar="CerrarModal">
                <p>¿Cerrar la estadía de <strong>@h.NombreHuesped</strong>?</p>
                <p>Total a cobrar: <strong>@h.TotalAcumulado?.ToString("C")</strong></p>
                @if (_puedeFijarFecha)
                {
                    <div class="form-grupo">
                        <label>Fecha y hora de Check-out (opcional — Gerencia/Desarrollador)</label>
                        <input type="datetime-local" @bind="_fechaCheckOutManual" />
                        <span class="page-subtitle" style="margin-top:2px;">Dejar vacío para usar la fecha y hora actuales.</span>
                    </div>
                }
                <button class="btn btn-bloque" @onclick="() => _vistaModal = VistaModal.ElegirMetodoPago">Sí, hacer Check-out</button>
            </ModalBase>
            break;

        case VistaModal.ElegirMetodoPago:
            <ModalBase Titulo='@($"Método de pago — {h.TotalAcumulado:C}")' OnCerrar="CerrarModal">
                @if (_errorModal is not null)
                {
                    <p class="mensaje-error">@_errorModal</p>
                }
                @foreach (var metodo in Enum.GetValues<MetodoPago>())
                {
                    <button class="btn btn-secundario btn-bloque" disabled="@_guardando" @onclick="() => ConfirmarCheckoutAsync(h, metodo)">@(_guardando ? "Guardando…" : metodo.ToString())</button>
                }
            </ModalBase>
            break;

        case VistaModal.ConfirmarLimpieza:
            <ModalBase Titulo="Marcar como limpia" OnCerrar="CerrarModal">
                <p>¿La habitación @h.Numero ya está lista para un nuevo huésped?</p>
                <button class="btn btn-bloque" disabled="@_guardando" @onclick="() => ConfirmarFinalizarLimpiezaAsync(h)">@(_guardando ? "Guardando…" : "Sí, está limpia")</button>
            </ModalBase>
            break;

        case VistaModal.ConfirmarFinMantenimiento:
            <ModalBase Titulo="Finalizar mantenimiento" OnCerrar="CerrarModal">
                <p>Motivo registrado: @h.MotivoMantenimiento</p>
                <p>¿Marcar la habitación @h.Numero como Disponible?</p>
                <button class="btn btn-bloque" disabled="@_guardando" @onclick="() => ConfirmarFinalizarMantenimientoAsync(h)">@(_guardando ? "Guardando…" : "Sí, finalizar")</button>
            </ModalBase>
            break;
    }
}

@if (_vistaTarifas)
{
    <ModalBase Titulo="Editar tarifas por noche" OnCerrar="() => _vistaTarifas = false">
        @if (_errorTarifas is not null)
        {
            <div class="caja-error"><p>@_errorTarifas</p></div>
        }
        <p style="font-size:0.8rem; color:var(--text-muted); margin-top:0;">Solo afecta a reservas/check-ins nuevos — no cambia el total de una estadía ya en curso.</p>
        <div style="max-height:60vh; overflow-y:auto;">
            @foreach (var hab in _habitaciones.OrderBy(x => x.Piso).ThenBy(x => x.Numero))
            {
                <div style="display:flex; align-items:center; gap:8px; border-bottom:1px solid var(--border); padding:8px 0;">
                    <div style="flex:1;">
                        <strong>@hab.Numero</strong> — @hab.EtiquetaTipo
                    </div>
                    <input type="text" style="width:90px;" value="@TarifaTextoEdicion(hab)" @oninput="e => _edicionTarifas[hab.HabitacionId] = e.Value?.ToString() ?? string.Empty" />
                    <button class="btn btn-secundario" style="padding:6px 12px; font-size:0.8rem;" disabled="@_guardandoTarifa" @onclick="() => GuardarTarifaAsync(hab)">Guardar</button>
                </div>
            }
        </div>
    </ModalBase>
}

@code {
    private enum VistaModal
    {
        MenuDisponible, PromptMantenimiento, MenuOcupada, DetalleHuesped,
        ConfirmarCheckout, ElegirMetodoPago, ConfirmarLimpieza, ConfirmarFinMantenimiento
    }

    private List<HabitacionCardDto> _habitaciones = new();
    private bool _cargando = true;
    private string? _error;
    private string? _errorModal;

    private string _textoBusqueda = string.Empty;
    private int _filtroPiso;
    private string _filtroTipo = string.Empty;
    private string _filtroEstado = string.Empty;

    private HabitacionCardDto? _habitacionSeleccionada;
    private VistaModal _vistaModal;
    private string _motivoMantenimiento = string.Empty;
    private bool _guardando;

    private bool _vistaTarifas;
    private string? _errorTarifas;
    private bool _guardandoTarifa;
    private readonly Dictionary<int, string> _edicionTarifas = new();
    private bool _puedeFijarFecha;
    private DateTime? _fechaCheckOutManual;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        Notificador.CambioDetectado += OnCambioDetectado;

        var estadoAuth = await AuthProvider.GetAuthenticationStateAsync();
        var rol = estadoAuth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        _puedeFijarFecha = rol is "Gerencia" or "Desarrollador";
    }

    private async Task CargarAsync()
    {
        try
        {
            _error = null;
            _habitaciones = await HabitacionService.ObtenerTodasAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el tablero de habitaciones: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    /// <summary>Habitaciones filtradas solo por piso+tipo — base para los contadores
    /// del KPI/chips de estado (que ignoran el filtro de estado, igual que en MAUI) y
    /// para HabitacionesFiltradas. Mismo patrón que Reservas.razor/Calendario.razor.</summary>
    private List<HabitacionCardDto> HabitacionesPorPisoYTipo()
    {
        var query = _habitaciones.AsEnumerable();

        if (_filtroPiso != 0)
        {
            query = query.Where(h => h.Piso == _filtroPiso);
        }

        if (!string.IsNullOrEmpty(_filtroTipo) && Enum.TryParse<TipoHabitacion>(_filtroTipo, out var tipo))
        {
            query = query.Where(h => h.Tipo == tipo);
        }

        return query.ToList();
    }

    private IEnumerable<HabitacionCardDto> HabitacionesFiltradas()
    {
        var query = HabitacionesPorPisoYTipo().AsEnumerable();

        if (!string.IsNullOrEmpty(_filtroEstado) && Enum.TryParse<EstadoHabitacion>(_filtroEstado, out var estado))
        {
            query = query.Where(h => h.Estado == estado);
        }

        if (!string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            var texto = _textoBusqueda.Trim();
            query = query.Where(h =>
                h.Numero.ToString().Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                (h.NombreHuesped?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (h.CelularHuesped?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (h.NumeroDocumentoHuesped?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return query;
    }

    private void OnBuscarInput(ChangeEventArgs e)
    {
        _textoBusqueda = e.Value?.ToString() ?? string.Empty;
    }

    private void AbrirMenuHabitacion(HabitacionCardDto habitacion)
    {
        _habitacionSeleccionada = habitacion;
        _errorModal = null;
        _motivoMantenimiento = string.Empty;
        _vistaModal = habitacion.Estado switch
        {
            EstadoHabitacion.Disponible => VistaModal.MenuDisponible,
            EstadoHabitacion.Ocupada => VistaModal.MenuOcupada,
            EstadoHabitacion.LimpiezaSalida => VistaModal.ConfirmarLimpieza,
            EstadoHabitacion.Mantenimiento => VistaModal.ConfirmarFinMantenimiento,
            _ => VistaModal.MenuDisponible
        };
    }

    private void CerrarModal()
    {
        _habitacionSeleccionada = null;
        _errorModal = null;
        _fechaCheckOutManual = null;
    }

    private string TarifaTextoEdicion(HabitacionCardDto hab) =>
        _edicionTarifas.TryGetValue(hab.HabitacionId, out var texto) ? texto : hab.TarifaNoche.ToString("0.00");

    private async Task GuardarTarifaAsync(HabitacionCardDto hab)
    {
        if (_guardandoTarifa)
        {
            return;
        }

        if (!decimal.TryParse(TarifaTextoEdicion(hab), out var nuevaTarifa))
        {
            _errorTarifas = $"Tarifa inválida para la habitación {hab.Numero}.";
            return;
        }

        _guardandoTarifa = true;
        _errorTarifas = null;
        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await HabitacionService.EditarTarifaAsync(hab.HabitacionId, nuevaTarifa, usuario.Id);
            _edicionTarifas.Remove(hab.HabitacionId);
            await CargarAsync();
            Notificador.Avisar("habitaciones");
        }
        catch (Exception ex)
        {
            _errorTarifas = ex.Message;
        }
        finally
        {
            _guardandoTarifa = false;
        }
    }

    private async Task ConfirmarIniciarMantenimientoAsync(HabitacionCardDto h)
    {
        if (string.IsNullOrWhiteSpace(_motivoMantenimiento))
        {
            _errorModal = "El motivo es obligatorio para pasar a Mantenimiento.";
            return;
        }

        await EjecutarAccionAsync(async () =>
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await HabitacionService.IniciarMantenimientoAsync(h.HabitacionId, _motivoMantenimiento.Trim(), usuario.Id);
        });
    }

    private Task SolicitarLimpiezaIntermediaAsync(HabitacionCardDto h) => EjecutarAccionAsync(async () =>
    {
        var usuario = await Sesion.ObtenerUsuarioActualAsync();
        await HabitacionService.RegistrarLimpiezaIntermediaAsync(h.HabitacionId, usuario.Id);
    });

    /// <summary>No usa EjecutarAccionAsync como el resto de las acciones porque, a
    /// diferencia de ellas, el Check-out termina navegando a otra página (el
    /// comprobante para imprimir) en vez de quedarse en Registro Hotel.</summary>
    private async Task ConfirmarCheckoutAsync(HabitacionCardDto h, MetodoPago metodo)
    {
        if (_guardando)
        {
            return;
        }
        if (h.EstadiaId is not { } estadiaId)
        {
            _errorModal = "Esta habitación no tiene una estadía activa.";
            return;
        }

        _guardando = true;
        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            var fechaManual = _puedeFijarFecha ? _fechaCheckOutManual : null;
            await HabitacionService.CheckOutAsync(estadiaId, usuario.Id, metodo, fechaManual);
            Notificador.Avisar("habitaciones");
            Navegacion.NavigateTo($"/comprobante/hotel/{estadiaId}");
        }
        catch (Exception ex)
        {
            _errorModal = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    private Task ConfirmarFinalizarLimpiezaAsync(HabitacionCardDto h) => EjecutarAccionAsync(async () =>
    {
        var usuario = await Sesion.ObtenerUsuarioActualAsync();
        await HabitacionService.FinalizarLimpiezaAsync(h.HabitacionId, usuario.Id);
    });

    private Task ConfirmarFinalizarMantenimientoAsync(HabitacionCardDto h) => EjecutarAccionAsync(async () =>
    {
        var usuario = await Sesion.ObtenerUsuarioActualAsync();
        await HabitacionService.FinalizarMantenimientoAsync(h.HabitacionId, usuario.Id);
    });

    /// <summary>Envoltorio común para toda acción que muta una habitación: ejecuta,
    /// recarga el tablero, cierra el modal, y avisa a los demás circuitos
    /// conectados — igual que ya hacía "Finalizar limpieza" en la versión mínima.
    /// El guard _guardando evita que un doble clic (ej. con WiFi lento) dispare la
    /// misma acción dos veces — un check-out o un check-in duplicado sería un error
    /// de caja real, no solo una molestia visual.</summary>
    private async Task EjecutarAccionAsync(Func<Task> accion)
    {
        if (_guardando)
        {
            return;
        }

        _guardando = true;
        try
        {
            await accion();
            await CargarAsync();
            CerrarModal();
            Notificador.Avisar("habitaciones");
        }
        catch (Exception ex)
        {
            _errorModal = ex.Message;
        }
        finally
        {
            _guardando = false;
        }
    }

    /// <summary>Si hay un modal de acciones abierto para una habitación puntual y
    /// justo esa habitación cambia de estado desde OTRO dispositivo (ej. alguien más
    /// ya hizo el check-out mientras yo tenía el modal abierto), cerrarlo en vez de
    /// dejarlo con datos viejos — confirmar una acción ahí encima operaría sobre un
    /// estado que ya no existe. Si cambió una habitación distinta a la que tengo
    /// abierta, no interrumpe nada.</summary>
    private async void OnCambioDetectado(string area)
    {
        if (area != "habitaciones")
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            var idSeleccionada = _habitacionSeleccionada?.HabitacionId;
            var estadoAntes = _habitacionSeleccionada?.Estado;
            var estadiaAntes = _habitacionSeleccionada?.EstadiaId;

            await CargarAsync();

            if (idSeleccionada is { } id)
            {
                var actualizada = _habitaciones.FirstOrDefault(h => h.HabitacionId == id);
                if (actualizada is null || actualizada.Estado != estadoAntes || actualizada.EstadiaId != estadiaAntes)
                {
                    CerrarModal();
                    _error = "Esta habitación se actualizó desde otro dispositivo — revisá el estado actual.";
                }
                else
                {
                    _habitacionSeleccionada = actualizada;
                }
            }

            StateHasChanged();
        });
    }

    private static string EtiquetaEstado(EstadoHabitacion estado) => estado switch
    {
        EstadoHabitacion.Disponible => "Disponible",
        EstadoHabitacion.Ocupada => "Ocupada",
        EstadoHabitacion.LimpiezaSalida => "Limpieza",
        EstadoHabitacion.Mantenimiento => "Mantenimiento",
        _ => estado.ToString()
    };

    private static string ColorParaClave(string clave) => clave switch
    {
        "ColorDisponible" => "var(--ok)",
        "ColorOcupada" => "var(--info)",
        "ColorLimpieza" => "var(--warn)",
        "ColorMantenimiento" => "var(--danger)",
        _ => "var(--text-muted)"
    };

    /// <summary>Texto sobre el badge de ColorParaClave — los 4 colores de estado son
    /// claros/pastel (heredados del tema oscuro de escritorio), blanco encima no
    /// contrasta lo suficiente, especialmente en Limpieza (amarillo).</summary>
    private static string ContrasteParaClave(string clave) => clave switch
    {
        "ColorDisponible" => "var(--ok-contrast)",
        "ColorOcupada" => "var(--info-contrast)",
        "ColorLimpieza" => "var(--warn-contrast)",
        "ColorMantenimiento" => "var(--danger-contrast)",
        _ => "white"
    };

    public void Dispose()
    {
        Notificador.CambioDetectado -= OnCambioDetectado;
    }
}
