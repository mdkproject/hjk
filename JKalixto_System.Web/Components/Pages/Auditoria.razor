@page "/auditoria"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@using JKalixto_System.Web.Services
@inject IAuditoriaService AuditoriaService
@inject SesionWebService Sesion

<PageTitle>Ver Auditoría</PageTitle>

<div style="padding:1.5rem;">
    <h1>Ver Auditoría</h1>

    @if (_sinPermiso)
    {
        <p style="color:#f28b82;">No tenés permiso para ver el registro de auditoría (solo Gerencia/Desarrollador).</p>
    }
    else if (_error is not null)
    {
        <p style="color:#f28b82;">@_error</p>
    }
    else
    {
        <input placeholder="Buscar por descripción, usuario o tipo de acción…"
               style="background:#292a2d; border:1px solid #3c4043; border-radius:6px; padding:8px; color:#e8eaed; width:100%; max-width:400px; margin-bottom:16px;"
               value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />

        @if (_cargando)
        {
            <p>Cargando…</p>
        }
        else
        {
            @foreach (var log in Filtrados())
            {
                <div style="border-bottom:1px solid #292a2d; padding:8px 0;">
                    <div style="display:flex; justify-content:space-between;">
                        <span style="background:#3c4043; border-radius:6px; padding:2px 6px; font-size:0.8rem;">@log.TipoAccion</span>
                        <span style="color:#9aa0a6; font-size:0.85rem;">@log.Timestamp.ToString("dd/MM HH:mm")</span>
                    </div>
                    <div>@log.Descripcion</div>
                    <div style="color:#9aa0a6; font-size:0.85rem;">@log.UsuarioNombre</div>
                </div>
            }
        }
    }
</div>

@code {
    private List<LogAuditoria> _logs = new();
    private bool _cargando = true;
    private bool _sinPermiso;
    private string? _error;
    private string _textoBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Resuelve el "usuario actual" del circuito ANTES de pedir los logs — si
            // esta es la primera página que visita este circuito (ej. se abrió el
            // navegador directo en /auditoria), ISessionService.UsuarioActual todavía
            // no está fijado y el chequeo de rol de AuditoriaService fallaría siempre,
            // aunque el usuario sí tuviera permiso.
            await Sesion.ObtenerUsuarioActualAsync();
            _logs = await AuditoriaService.ObtenerRecientesAsync(200);
        }
        catch (UnauthorizedAccessException)
        {
            _sinPermiso = true;
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar la auditoría: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private IEnumerable<LogAuditoria> Filtrados()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            return _logs;
        }

        var texto = _textoBusqueda.Trim();
        return _logs.Where(l =>
            l.Descripcion.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            l.UsuarioNombre.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            l.TipoAccion.Contains(texto, StringComparison.OrdinalIgnoreCase));
    }
}
