@page "/reclamos"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@using JKalixto_System.Web.Services
@inject IReclamosService ReclamosService
@inject SesionWebService Sesion
@inject NavigationManager Navegacion

<PageTitle>Libro de Reclamaciones</PageTitle>

<div style="padding:1.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
        <h1>Libro de Reclamaciones</h1>
        <button class="btn" @onclick='() => Navegacion.NavigateTo("/reclamos/nuevo")'>+ Nuevo Reclamo/Queja</button>
    </div>

    @if (_error is not null)
    {
        <p style="color:#f28b82;">@_error</p>
    }

    <input placeholder="Buscar por nombre, documento o bien contratado…"
           style="background:#292a2d; border:1px solid #3c4043; border-radius:6px; padding:8px; color:#e8eaed; width:100%; max-width:400px; margin-bottom:16px;"
           value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />

    @if (_cargando)
    {
        <p>Cargando…</p>
    }
    else
    {
        @foreach (var r in Filtrados())
        {
            <div style="border:1px solid #3c4043; border-radius:8px; padding:10px; margin-bottom:8px; cursor:pointer;" @onclick="() => _seleccionado = r">
                <div style="display:flex; justify-content:space-between;">
                    <span style="background:@(r.Tipo == TipoReclamoQueja.Reclamo ? "#DC2626" : "#D97706"); color:white; border-radius:6px; padding:2px 6px; font-size:0.8rem;">@r.EtiquetaTipo</span>
                    <span style="color:@(r.Estado == EstadoReclamo.Respondido ? "#81c995" : "#f28b82");">@r.EtiquetaEstado</span>
                </div>
                <strong>@r.NombreCompleto</strong>
                <div style="color:#9aa0a6; font-size:0.85rem;">@r.BienContratado — Presentado: @r.Fecha.ToString("dd/MM/yyyy")</div>
                @if (r.PlazoVencido && r.Estado != EstadoReclamo.Respondido)
                {
                    <div style="color:#f28b82; font-weight:600; font-size:0.85rem;">¡PLAZO VENCIDO!</div>
                }
            </div>
        }
    }
</div>

@if (_seleccionado is { } sel)
{
    <ModalBase Titulo="@sel.NombreCompleto" OnCerrar="() => { _seleccionado = null; _respuesta = string.Empty; }">
        <p>Documento: @sel.NumeroDocumento</p>
        <p>Bien contratado: @sel.BienContratado</p>
        @if (sel.MontoReclamado is not null)
        {
            <p>Monto reclamado: @sel.MontoReclamado?.ToString("C")</p>
        }
        <p>Detalle: @sel.DetalleReclamo</p>
        @if (!string.IsNullOrWhiteSpace(sel.PedidoConsumidor))
        {
            <p>Pedido del consumidor: @sel.PedidoConsumidor</p>
        }
        <p>Plazo legal de respuesta: @sel.FechaLimiteRespuesta.ToString("dd/MM/yyyy") @(sel.PlazoVencido && sel.Estado != EstadoReclamo.Respondido ? "— ¡PLAZO VENCIDO!" : "")</p>

        @if (sel.Estado == EstadoReclamo.Respondido)
        {
            <p style="color:#81c995;">Respondido el @sel.FechaRespuesta?.ToString("dd/MM/yyyy"): @sel.RespuestaEstablecimiento</p>
        }
        else
        {
            <textarea style="width:100%; min-height:70px;" placeholder="Escribí la respuesta del establecimiento…" @bind="_respuesta" @bind:event="oninput"></textarea>
            <button class="btn btn-bloque" @onclick="() => ResponderAsync(sel)">Enviar respuesta</button>
        }
    </ModalBase>
}

@code {
    private List<ReclamoCardDto> _reclamos = new();
    private bool _cargando = true;
    private string? _error;
    private string _textoBusqueda = string.Empty;
    private ReclamoCardDto? _seleccionado;
    private string _respuesta = string.Empty;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            _reclamos = await ReclamosService.ObtenerTodosAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar los reclamos: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private IEnumerable<ReclamoCardDto> Filtrados()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            return _reclamos;
        }

        var texto = _textoBusqueda.Trim();
        return _reclamos.Where(r =>
            r.NombreCompleto.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            r.NumeroDocumento.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            r.BienContratado.Contains(texto, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ResponderAsync(ReclamoCardDto r)
    {
        if (string.IsNullOrWhiteSpace(_respuesta))
        {
            _error = "La respuesta no puede estar vacía.";
            return;
        }

        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await ReclamosService.ResponderAsync(r.Id, _respuesta.Trim(), usuario.Id);
            _seleccionado = null;
            _respuesta = string.Empty;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo enviar la respuesta: {ex.Message}";
        }
    }
}
