@page "/reclamos"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@using JKalixto_System.Web.Services
@inject IReclamosService ReclamosService
@inject SesionWebService Sesion
@inject INotificadorCambios Notificador
@inject NavigationManager Navegacion
@implements IDisposable

<PageTitle>Libro de Reclamaciones</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1>Libro de Reclamaciones</h1>
            <p class="page-subtitle">Registro de reclamos y quejas (Ley N° 29571 — INDECOPI)</p>
        </div>
        <div class="page-actions">
            <button class="btn" @onclick='() => Navegacion.NavigateTo("/reclamos/nuevo")'>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Nuevo Reclamo/Queja
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="caja-error"><p>@_error</p></div>
    }

    @{
        var total = _reclamos.Count;
        var pendientes = _reclamos.Count(r => r.Estado == EstadoReclamo.Pendiente);
        var vencidos = _reclamos.Count(r => r.PlazoVencido);
        var respondidos = _reclamos.Count(r => r.Estado == EstadoReclamo.Respondido);
    }

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Total registrados</div>
            <div class="kpi-value">@total</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Pendientes de respuesta</div>
            <div class="kpi-value" style="color:var(--warn);">@pendientes</div>
        </div>
        <div class="kpi-card" style="@(vencidos > 0 ? "border-color:var(--danger); background:var(--danger-soft);" : "")">
            <div class="kpi-label">Plazo vencido</div>
            <div class="kpi-value" style="color:var(--danger);">@vencidos</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Respondidos</div>
            <div class="kpi-value" style="color:var(--ok);">@respondidos</div>
        </div>
    </div>

    <div class="card" style="margin-bottom:20px;">
        <div class="search-input" style="margin-bottom:14px;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
            <input placeholder="Buscar por nombre, documento o bien contratado…" value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />
        </div>

        <div class="filtro-grupo">
            <span class="filtro-grupo-label">Tipo</span>
            <div class="filtro-chips">
                <button type="button" class="filtro-chip @(_filtroTipo == "" ? "activo" : "")" @onclick='() => _filtroTipo = ""'>Todos</button>
                <button type="button" class="filtro-chip @(_filtroTipo == "Reclamo" ? "activo" : "")" @onclick='() => _filtroTipo = "Reclamo"'>Reclamo</button>
                <button type="button" class="filtro-chip @(_filtroTipo == "Queja" ? "activo" : "")" @onclick='() => _filtroTipo = "Queja"'>Queja</button>
            </div>
        </div>

        <div class="filtro-grupo" style="margin-bottom:0;">
            <span class="filtro-grupo-label">Estado</span>
            <div class="filtro-chips">
                <button type="button" class="filtro-chip @(_filtroEstado == "" ? "activo" : "")" @onclick='() => _filtroEstado = ""'>Todos</button>
                <button type="button" class="filtro-chip filtro-chip-estado filtro-chip-limpieza @(_filtroEstado == "Pendiente" ? "activo" : "")" @onclick='() => _filtroEstado = "Pendiente"'>Pendiente (@pendientes)</button>
                <button type="button" class="filtro-chip filtro-chip-estado filtro-chip-mantenimiento @(_filtroEstado == "Vencido" ? "activo" : "")" @onclick='() => _filtroEstado = "Vencido"'>Plazo vencido (@vencidos)</button>
                <button type="button" class="filtro-chip filtro-chip-estado filtro-chip-disponible @(_filtroEstado == "Respondido" ? "activo" : "")" @onclick='() => _filtroEstado = "Respondido"'>Respondido (@respondidos)</button>
            </div>
        </div>
    </div>

    @if (_cargando)
    {
        <p class="empty-state">Cargando…</p>
    }
    else
    {
        var filtrados = Filtrados().ToList();
        @if (filtrados.Count == 0)
        {
            <p class="empty-state">@(_reclamos.Count == 0 ? "Todavía no hay reclamos ni quejas registrados." : "Ningún reclamo o queja coincide con este filtro.")</p>
        }
        @foreach (var r in filtrados)
        {
            <div class="card card-clickable" style="margin-bottom:8px; border-left:3px solid @ColorBorde(r);" @onclick="() => _seleccionado = r">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span class="badge" style="background:@(r.Tipo == TipoReclamoQueja.Reclamo ? "var(--danger)" : "var(--warn)"); color:@(r.Tipo == TipoReclamoQueja.Reclamo ? "var(--danger-contrast)" : "var(--warn-contrast)");">@r.EtiquetaTipo</span>
                    <span class="badge" style="background:@(r.Estado == EstadoReclamo.Respondido ? "var(--ok-soft)" : "var(--danger-soft)"); color:@(r.Estado == EstadoReclamo.Respondido ? "var(--ok)" : "#fca5a5");">@r.EtiquetaEstado</span>
                </div>
                <strong style="display:block; margin-top:6px;">@r.NombreCompleto</strong>
                <div style="color:var(--text-secondary); font-size:0.85rem;">@r.BienContratado — Presentado: @r.Fecha.ToString("dd/MM/yyyy")</div>
                <div style="font-weight:600; font-size:0.85rem; margin-top:2px; color:@ColorBorde(r);">@PlazoTexto(r)</div>
            </div>
        }
    }
</div>

@if (_seleccionado is { } sel)
{
    <ModalBase Titulo="@sel.NombreCompleto" OnCerrar="() => { _seleccionado = null; _respuesta = string.Empty; }">
        <p>Documento: @sel.NumeroDocumento</p>
        <p>Bien contratado: @sel.BienContratado</p>
        @if (sel.MontoReclamado is not null)
        {
            <p>Monto reclamado: @sel.MontoReclamado?.ToString("C")</p>
        }
        <p>Detalle: @sel.DetalleReclamo</p>
        @if (!string.IsNullOrWhiteSpace(sel.PedidoConsumidor))
        {
            <p>Pedido del consumidor: @sel.PedidoConsumidor</p>
        }
        <p>Plazo legal de respuesta: @sel.FechaLimiteRespuesta.ToString("dd/MM/yyyy") — <span style="color:@ColorBorde(sel); font-weight:600;">@PlazoTexto(sel)</span></p>

        @if (sel.Estado == EstadoReclamo.Respondido)
        {
            <p style="color:var(--ok);">Respondido el @sel.FechaRespuesta?.ToString("dd/MM/yyyy"): @sel.RespuestaEstablecimiento</p>
        }
        else
        {
            <textarea style="width:100%; min-height:70px;" placeholder="Escribí la respuesta del establecimiento…" @bind="_respuesta" @bind:event="oninput"></textarea>
            <button class="btn btn-bloque" disabled="@_guardando" @onclick="() => ResponderAsync(sel)">@(_guardando ? "Enviando…" : "Enviar respuesta")</button>
        }
    </ModalBase>
}

@code {
    private List<ReclamoCardDto> _reclamos = new();
    private bool _cargando = true;
    private string? _error;
    private string _textoBusqueda = string.Empty;
    private string _filtroTipo = string.Empty;
    private string _filtroEstado = string.Empty;
    private ReclamoCardDto? _seleccionado;
    private string _respuesta = string.Empty;
    private bool _guardando;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        Notificador.CambioDetectado += OnCambioDetectado;
    }

    private async Task CargarAsync()
    {
        try
        {
            _reclamos = await ReclamosService.ObtenerTodosAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar los reclamos: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async void OnCambioDetectado(string area)
    {
        if (area != "reclamos")
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await CargarAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Notificador.CambioDetectado -= OnCambioDetectado;

    /// <summary>Filtra por tipo/estado/búsqueda y ordena por urgencia: primero los
    /// Pendientes (los más próximos a vencer arriba de todo), Respondidos al final
    /// — para que un vistazo rápido a la pantalla muestre lo más urgente primero,
    /// en vez de solo lo más reciente.</summary>
    private IEnumerable<ReclamoCardDto> Filtrados()
    {
        var query = _reclamos.AsEnumerable();

        if (!string.IsNullOrEmpty(_filtroTipo) && Enum.TryParse<TipoReclamoQueja>(_filtroTipo, out var tipo))
        {
            query = query.Where(r => r.Tipo == tipo);
        }

        if (_filtroEstado == "Vencido")
        {
            query = query.Where(r => r.PlazoVencido);
        }
        else if (!string.IsNullOrEmpty(_filtroEstado) && Enum.TryParse<EstadoReclamo>(_filtroEstado, out var estado))
        {
            query = query.Where(r => r.Estado == estado);
        }

        if (!string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            var texto = _textoBusqueda.Trim();
            query = query.Where(r =>
                r.NombreCompleto.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                r.NumeroDocumento.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                r.BienContratado.Contains(texto, StringComparison.OrdinalIgnoreCase));
        }

        return query
            .OrderBy(r => r.Estado == EstadoReclamo.Respondido ? 1 : 0)
            .ThenBy(r => r.Estado == EstadoReclamo.Pendiente ? r.FechaLimiteRespuesta : DateTime.MaxValue)
            .ThenByDescending(r => r.Fecha);
    }

    /// <summary>Texto de urgencia: cuenta días en vez de solo un booleano
    /// "vencido/no vencido" — más accionable para decidir a cuál responder primero.</summary>
    private static string PlazoTexto(ReclamoCardDto r)
    {
        if (r.Estado == EstadoReclamo.Respondido)
        {
            return $"Respondido el {r.FechaRespuesta:dd/MM/yyyy}";
        }

        var dias = (r.FechaLimiteRespuesta.Date - DateTime.Now.Date).Days;
        return dias switch
        {
            < 0 => $"¡Plazo vencido hace {-dias} día(s)!",
            0 => "Vence hoy",
            1 => "Vence mañana",
            _ => $"Vence en {dias} días"
        };
    }

    private static string ColorBorde(ReclamoCardDto r)
    {
        if (r.Estado == EstadoReclamo.Respondido)
        {
            return "var(--ok)";
        }

        return r.PlazoVencido ? "var(--danger)" : "var(--warn)";
    }

    private async Task ResponderAsync(ReclamoCardDto r)
    {
        if (_guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_respuesta))
        {
            _error = "La respuesta no puede estar vacía.";
            return;
        }

        _guardando = true;
        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await ReclamosService.ResponderAsync(r.Id, _respuesta.Trim(), usuario.Id);
            _seleccionado = null;
            _respuesta = string.Empty;
            await CargarAsync();
            Notificador.Avisar("reclamos");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo enviar la respuesta: {ex.Message}";
        }
        finally
        {
            _guardando = false;
        }
    }
}
