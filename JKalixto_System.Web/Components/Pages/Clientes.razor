@page "/clientes"
@using JKalixto_System.Application.Services
@using JKalixto_System.Domain.Models
@using JKalixto_System.Web.Services
@inject IClientesService ClientesService
@inject IHabitacionService HabitacionService
@inject ISaunaService SaunaService
@inject INotificadorCambios Notificador
@inject SesionWebService Sesion
@inject NavigationManager Navegacion

<PageTitle>Clientes</PageTitle>

<div style="padding:1.5rem;">
    <h1>Clientes</h1>

    @if (_error is not null)
    {
        <p style="color:#f28b82;">@_error</p>
    }

    <div style="display:flex; gap:8px; margin-bottom:12px;">
        <button class="btn @(_origen == "Hotel" ? "" : "btn-secundario")" @onclick="CambiarOrigenHotelAsync">Hotel</button>
        <button class="btn @(_origen == "Sauna" ? "" : "btn-secundario")" @onclick="CambiarOrigenSaunaAsync">Sauna</button>
    </div>

    <input placeholder="Buscar por nombre o ubicación…"
           style="background:#292a2d; border:1px solid #3c4043; border-radius:6px; padding:8px; color:#e8eaed; width:100%; max-width:400px; margin-bottom:16px;"
           value="@_textoBusqueda" @oninput="e => _textoBusqueda = e.Value?.ToString() ?? string.Empty" />

    @if (_cargando)
    {
        <p>Cargando…</p>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="text-align:left; border-bottom:1px solid #3c4043;">
                    <th style="padding:6px;">Hora</th>
                    <th style="padding:6px;">Cliente</th>
                    <th style="padding:6px;">Ubicación</th>
                    <th style="padding:6px;">Estado</th>
                    <th style="padding:6px;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Filtrados())
                {
                    <tr style="border-bottom:1px solid #292a2d; cursor:pointer;" @onclick="() => SeleccionarAsync(c)">
                        <td style="padding:6px;">@c.HoraRegistro.ToString("HH:mm")</td>
                        <td style="padding:6px;">@c.NombreCliente</td>
                        <td style="padding:6px;">@c.UbicacionTexto</td>
                        <td style="padding:6px;">@c.EstadoTexto</td>
                        <td style="padding:6px;">@c.Total.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_detalle is { } d)
{
    <ModalBase Titulo="@d.NombreCliente" OnCerrar="() => _detalle = null">
        <p>@d.EtiquetaTipoDocumento: @d.NumeroDocumento</p>
        <p>Celular: @d.Celular</p>
        <p>Ubicación: @d.UbicacionTexto</p>
        <p>Ingreso: @d.HoraRegistro.ToString("dd/MM/yyyy HH:mm")</p>
        <p>Estado: @d.EstadoTexto</p>

        <h4>Consumos</h4>
        @if (d.Consumos.Count == 0)
        {
            <p style="color:#9aa0a6;">Sin consumos registrados.</p>
        }
        @foreach (var item in d.Consumos)
        {
            <div style="display:flex; justify-content:space-between; font-size:0.9rem;">
                <span>@item.Cantidad × @item.Descripcion</span>
                <span>@item.Subtotal.ToString("C")</span>
            </div>
        }
        <p style="font-weight:700; margin-top:8px;">Total: @d.Total.ToString("C")</p>

        @if (d.ClienteSaunaIdParaVenta.HasValue || d.EstadiaIdParaVenta.HasValue)
        {
            <button class="btn btn-bloque" @onclick="() => IrAVenta(d)">+ Agregar Consumo (POS)</button>
        }
        @if (d.EstaActivo)
        {
            <button class="btn btn-secundario btn-bloque" @onclick="() => _vistaPago = true">Pagar y Finalizar</button>
        }

        @if (_vistaPago)
        {
            @if (d.EstadiaIdParaVenta.HasValue)
            {
                <p style="margin-top:8px;">Método de pago:</p>
                @foreach (var metodo in Enum.GetValues<MetodoPago>())
                {
                    <button class="btn btn-secundario btn-bloque" @onclick="() => FinalizarConCheckoutAsync(d, metodo)">@metodo</button>
                }
            }
            else
            {
                <p style="margin-top:8px;">¿Confirmar el fin de la sesión de @d.NombreCliente?</p>
                <button class="btn btn-peligro btn-bloque" @onclick="() => FinalizarSesionSaunaAsync(d)">Sí, finalizar</button>
            }
        }
    </ModalBase>
}

@code {
    private string _origen = "Hotel";
    private string _textoBusqueda = string.Empty;
    private bool _cargando = true;
    private string? _error;
    private List<ClienteUnificadoDto> _clientes = new();
    private DetalleClienteDto? _detalle;
    private bool _vistaPago;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CambiarOrigenHotelAsync()
    {
        _origen = "Hotel";
        await CargarAsync();
    }

    private async Task CambiarOrigenSaunaAsync()
    {
        _origen = "Sauna";
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        try
        {
            _clientes = _origen == "Hotel"
                ? await ClientesService.ObtenerClientesHotelAsync()
                : await ClientesService.ObtenerClientesSaunaAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar la lista: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private IEnumerable<ClienteUnificadoDto> Filtrados()
    {
        if (string.IsNullOrWhiteSpace(_textoBusqueda))
        {
            return _clientes;
        }

        var texto = _textoBusqueda.Trim();
        return _clientes.Where(c =>
            c.NombreCliente.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
            c.UbicacionTexto.Contains(texto, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SeleccionarAsync(ClienteUnificadoDto c)
    {
        _vistaPago = false;
        try
        {
            _detalle = c.Origen == "Hotel"
                ? await ClientesService.ObtenerDetalleHotelAsync(c.EstadiaId!.Value)
                : await ClientesService.ObtenerDetalleSaunaAsync(c.ClienteSaunaId!.Value);
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el detalle: {ex.Message}";
        }
    }

    private void IrAVenta(DetalleClienteDto d)
    {
        var nombre = Uri.EscapeDataString(d.NombreParaVenta ?? d.NombreCliente);
        if (d.EstadiaIdParaVenta.HasValue)
        {
            Navegacion.NavigateTo($"/sauna/venta?estadiaId={d.EstadiaIdParaVenta}&numero={d.NumeroHabitacionParaVenta}&nombre={nombre}");
        }
        else if (d.ClienteSaunaIdParaVenta.HasValue)
        {
            Navegacion.NavigateTo($"/sauna/venta?clienteSaunaId={d.ClienteSaunaIdParaVenta}&nombre={nombre}&esHuespedHotel={d.EsHuespedHotelParaVenta}");
        }
    }

    private async Task FinalizarConCheckoutAsync(DetalleClienteDto d, MetodoPago metodo)
    {
        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await HabitacionService.CheckOutAsync(d.EstadiaIdParaVenta!.Value, usuario.Id, metodo);
            _detalle = null;
            await CargarAsync();
            Notificador.Avisar("habitaciones");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo hacer el check-out: {ex.Message}";
        }
    }

    private async Task FinalizarSesionSaunaAsync(DetalleClienteDto d)
    {
        try
        {
            var usuario = await Sesion.ObtenerUsuarioActualAsync();
            await SaunaService.FinalizarSesionAsync(d.ClienteSaunaIdParaVenta!.Value, usuario.Id);
            _detalle = null;
            await CargarAsync();
            Notificador.Avisar("sauna");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo finalizar la sesión: {ex.Message}";
        }
    }
}
