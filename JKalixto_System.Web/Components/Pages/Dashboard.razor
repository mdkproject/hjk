@page "/reportes"
@using JKalixto_System.Application.Services
@using JKalixto_System.Web.Services
@inject IDashboardService DashboardService
@inject INotificadorCambios Notificador
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable

<PageTitle>Reportes</PageTitle>

<div class="page">
    <div class="page-header">
        <div>
            <h1>Reportes</h1>
            <p class="page-subtitle">Panel gerencial — datos de hoy</p>
        </div>
        <div class="page-actions no-imprimir">
            <button class="btn btn-secundario" @onclick="CargarAsync">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.6-6.3M21 4v5h-5" /></svg>
                Refrescar
            </button>
            <a class="btn btn-secundario" href="/reportes/exportar-excel">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg>
                Exportar Excel
            </a>
            <button class="btn btn-secundario" type="button" onclick="window.print()">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                Imprimir / PDF
            </button>
            <a class="btn" href="/reportes/mensual">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                Ver Informe Mensual
            </a>
            <a class="btn" href="/reportes/rango">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><path d="m9 15 2 2 4-4" /></svg>
                Reporte por Rango de Fechas
            </a>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="caja-error"><p>@_error</p></div>
    }

    @if (_resumen is null)
    {
        <p class="empty-state">Cargando…</p>
    }
    else
    {
        @if (_resumen.AlertasActivas > 0)
        {
            <div class="caja-error">
                <p>Hay @_resumen.AlertasActivas habitación(es) en mantenimiento hace más de 4 horas — revisar.</p>
            </div>
        }

        <div class="kpi-grid" style="margin-bottom:24px;">
            <div class="kpi-card" style="border-color:var(--accent-border); background:var(--accent-soft);">
                <div class="kpi-label">Total Hoy</div>
                <div class="kpi-value">@(_puedeVerFinanzas ? _resumen.IngresosTotalHoy.ToString("C") : "***")</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Ingresos Hotel</div>
                <div class="kpi-value">@(_puedeVerFinanzas ? _resumen.IngresosHotelHoy.ToString("C") : "***")</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Ingresos Sauna</div>
                <div class="kpi-value">@(_puedeVerFinanzas ? _resumen.IngresosSaunaHoy.ToString("C") : "***")</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Ocupación</div>
                <div class="kpi-value">@_resumen.TasaOcupacion.ToString("0.0")%</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Tarifa Promedio (ADR)</div>
                <div class="kpi-value">@(_puedeVerFinanzas ? _resumen.TarifaPromedioDiaria.ToString("C") : "***")</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">RevPAR</div>
                <div class="kpi-value">@(_puedeVerFinanzas ? _resumen.IngresoPorHabitacionDisponible.ToString("C") : "***")</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Clientes Sauna Hoy</div>
                <div class="kpi-value">@_resumen.ClientesSaunaHoy</div>
            </div>
        </div>

        <div class="section-title" style="margin-top:0;">Estado de Habitaciones</div>
        <div class="card" style="margin-bottom:24px;">
            <div style="display:flex; height:20px; border-radius:5px; overflow:hidden; margin-bottom:14px;">
                @foreach (var e in _resumen.ResumenEstados)
                {
                    <div style="width:@(e.AnchoBarra)px; background:@ColorParaClave(e.ClaveColorBarra);" title="@e.Etiqueta: @e.Cantidad"></div>
                }
            </div>
            <div style="display:flex; gap:18px; flex-wrap:wrap;">
                @foreach (var e in _resumen.ResumenEstados)
                {
                    <span style="font-size:0.88rem;"><span style="display:inline-block; width:10px; height:10px; background:@ColorParaClave(e.ClaveColorBarra); border-radius:3px; margin-right:6px; vertical-align:-1px;"></span>@e.Etiqueta: @e.Cantidad</span>
                }
            </div>
        </div>

        <div class="section-title">Últimos Eventos</div>
        <div class="card">
            @foreach (var log in _resumen.UltimosEventos)
            {
                <div style="border-bottom:1px solid var(--border); padding:8px 0; font-size:0.9rem;">
                    <span style="color:var(--text-muted);">@log.Timestamp.ToString("dd/MM HH:mm")</span> — @log.Descripcion
                </div>
            }
        </div>
    }
</div>

@code {
    private ResumenDashboardDto? _resumen;
    private string? _error;
    private bool _puedeVerFinanzas;

    protected override async Task OnInitializedAsync()
    {
        // Mismo criterio que DashboardViewModel.PuedeVerFinanzas en MAUI: un
        // Recepcionista ve ocupación y clientes de sauna, pero NO montos de dinero
        // (ingresos, ADR, RevPAR) — esos quedan en "***". Se determina acá (no en
        // el servidor/DTO) porque es una regla de PRESENTACIÓN por rol, igual que
        // "Ver Auditoría" en MainLayout.razor.
        var estadoAuth = await AuthProvider.GetAuthenticationStateAsync();
        var rol = estadoAuth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
        _puedeVerFinanzas = rol is "Gerencia" or "Desarrollador";

        await CargarAsync();
        Notificador.CambioDetectado += OnCambioDetectado;
    }

    private async Task CargarAsync()
    {
        try
        {
            _error = null;
            _resumen = await DashboardService.ObtenerResumenAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo cargar el resumen: {ex.Message}";
        }
    }

    /// <summary>El dashboard resume TODO el sistema (ingresos, ocupación, últimos
    /// eventos), así que se refresca ante cualquier área — no vale la pena filtrar
    /// por una sola, a diferencia de una página específica.</summary>
    private async void OnCambioDetectado(string area)
    {
        await InvokeAsync(async () =>
        {
            await CargarAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Notificador.CambioDetectado -= OnCambioDetectado;

    private static string ColorParaClave(string clave) => clave switch
    {
        "ColorDisponible" => "var(--ok)",
        "ColorOcupada" => "var(--info)",
        "ColorLimpieza" => "var(--warn)",
        "ColorMantenimiento" => "var(--danger)",
        _ => "var(--text-muted)"
    };
}
