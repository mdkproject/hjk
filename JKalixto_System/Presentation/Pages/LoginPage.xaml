<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JKalixto_System.Presentation.ViewModels"
             x:Class="JKalixto_System.Presentation.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="*,Auto,*" ColumnDefinitions="*,Auto,*">

        <Border Grid.Row="1" Grid.Column="1"
                BackgroundColor="{DynamicResource ColorTarjeta}"
                Stroke="{DynamicResource ColorBorde}"
                StrokeThickness="1"
                Padding="32"
                WidthRequest="380">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="18">

                <Label Text="🏨 HKX"
                       FontSize="45"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ColorAcento}"
                       HorizontalOptions="Center" />

                <Label Text="Hotel &amp; Sauna — Cerro Colorado, Arequipa"
                       FontSize="19"
                       TextColor="{DynamicResource ColorTextoSecundario}"
                       HorizontalOptions="Center" />

                <BoxView HeightRequest="1" Color="{DynamicResource ColorBorde}" Margin="0,6" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="Usuario" FontSize="21" TextColor="{DynamicResource ColorTextoSecundario}" />
                    <Entry Text="{Binding Username}"
                           Placeholder="usuario.apellido"
                           BackgroundColor="{DynamicResource ColorFondo}"
                           ReturnType="Next" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Contraseña" FontSize="21" TextColor="{DynamicResource ColorTextoSecundario}" />
                    <Entry Text="{Binding Password}"
                           IsPassword="True"
                           Placeholder="••••••"
                           BackgroundColor="{DynamicResource ColorFondo}"
                           ReturnType="Go"
                           ReturnCommand="{Binding IniciarSesionCommand}" />
                </VerticalStackLayout>

                <Label Text="{Binding MensajeError}"
                       TextColor="{DynamicResource ColorMantenimiento}"
                       FontSize="21"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HayError}" />

                <Button Text="Ingresar"
                        Command="{Binding IniciarSesionCommand}"
                        BackgroundColor="{DynamicResource ColorAcento}"
                        TextColor="{DynamicResource ColorFondo}"
                        HeightRequest="48" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    Color="{DynamicResource ColorAcento}" />

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
