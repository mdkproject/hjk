<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JKalixto_System.Presentation.ViewModels"
             xmlns:services="clr-namespace:JKalixto_System.Application.Services"
             x:Class="JKalixto_System.Presentation.Pages.SaunaRegistroPage"
             x:DataType="vm:SaunaRegistroViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ColorFondo}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="6">
                <Label Text="Tipo de documento" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="DNI" Command="{Binding SeleccionarTipoDocumentoCommand}" CommandParameter="DNI"
                            BackgroundColor="{DynamicResource ColorTarjeta}" TextColor="{DynamicResource ColorTextoPrimario}" HeightRequest="40" FontAttributes="None" />
                    <Button Text="Pasaporte" Command="{Binding SeleccionarTipoDocumentoCommand}" CommandParameter="Pasaporte"
                            BackgroundColor="{DynamicResource ColorTarjeta}" TextColor="{DynamicResource ColorTextoPrimario}" HeightRequest="40" FontAttributes="None" />
                    <Button Text="Carné Ext." Command="{Binding SeleccionarTipoDocumentoCommand}" CommandParameter="Carné Ext."
                            BackgroundColor="{DynamicResource ColorTarjeta}" TextColor="{DynamicResource ColorTextoPrimario}" HeightRequest="40" FontAttributes="None" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding TipoDocumentoTexto, StringFormat='Número de {0} *'}" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" />
                <Entry Text="{Binding NumeroDocumento}" Placeholder="12345678" BackgroundColor="{DynamicResource ColorTarjeta}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Nombre completo *" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" />
                <Entry Text="{Binding NombreCompleto}" Placeholder="Nombres y apellidos" BackgroundColor="{DynamicResource ColorTarjeta}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Número de candado *" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" />
                <Entry Text="{Binding NumeroCandado}" Placeholder="Ej: 14" BackgroundColor="{DynamicResource ColorTarjeta}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Sección" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" />
                <HorizontalStackLayout Spacing="10">
                    <Switch IsToggled="{Binding EsSeccionDamas}" OnColor="{DynamicResource ColorSaunaDamas}" />
                    <Label Text="👩" FontSize="26" VerticalOptions="Center" Opacity="0.35">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding EsSeccionDamas}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="General" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource ColorTextoSecundario}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding EsSeccionDamas}" Value="True">
                                <Setter Property="Text" Value="Damas" />
                                <Setter Property="TextColor" Value="{DynamicResource ColorSaunaDamas}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{DynamicResource ColorBorde}" Margin="0,4" />

            <VerticalStackLayout Spacing="6">
                <Label Text="¿Es huésped del Hotel? (opcional — entrada gratis si coincide)" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="EntryBusquedaHuesped" Grid.Column="0"
                           Text="{Binding BusquedaHuesped}"
                           Placeholder="Escribe el nombre del huésped..."
                           BackgroundColor="{DynamicResource ColorTarjeta}" />
                    <Button Grid.Column="1" Text="✕" Command="{Binding QuitarHuespedCommand}"
                            IsVisible="{Binding EsHuespedHotel}"
                            BackgroundColor="{DynamicResource ColorMantenimiento}" TextColor="White"
                            WidthRequest="44" FontAttributes="Bold" Padding="0" />
                </Grid>

                <!-- Confirmación visual de que quedó vinculado a una habitación -->
                <HorizontalStackLayout Spacing="6" IsVisible="{Binding EsHuespedHotel}">
                    <Label Text="✓" TextColor="{DynamicResource ColorDisponible}" FontAttributes="Bold" FontSize="19" />
                    <Label Text="{Binding HuespedSeleccionado.Numero, StringFormat='Vinculado a la habitación {0} — entrada gratis'}"
                           FontSize="17" TextColor="{DynamicResource ColorDisponible}" />
                </HorizontalStackLayout>

                <!-- Sugerencias de autocompletado — aparecen mientras se escribe;
                     se navegan con el mouse o con las flechas ↑/↓ + Enter. -->
                <Border IsVisible="{Binding MostrarSugerencias}"
                        BackgroundColor="{DynamicResource ColorTarjeta}"
                        Stroke="{DynamicResource ColorBorde}"
                        StrokeThickness="1"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <CollectionView ItemsSource="{Binding Sugerencias}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SugerenciaHuespedItem">
                                <Grid Padding="12,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.SeleccionarSugerenciaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding EsResaltado}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorFondo}" />
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding NombreHuesped}" FontSize="19" VerticalOptions="Center" />
                                        <Label Text="{Binding Numero, StringFormat='Hab. {0}'}" FontSize="15" TextColor="{DynamicResource ColorTextoSecundario}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding MensajeError}"
                   TextColor="{DynamicResource ColorMantenimiento}"
                   FontSize="21"
                   IsVisible="{Binding HayError}" />

            <Button Text="Registrar Cliente"
                    Command="{Binding ConfirmarCommand}"
                    BackgroundColor="{DynamicResource ColorAcento}"
                    TextColor="{DynamicResource ColorFondo}"
                    HeightRequest="50"
                    Margin="0,10,0,0" />

            <Button Text="Cancelar"
                    Command="{Binding CancelarCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource ColorTextoSecundario}"
                    HeightRequest="40" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource ColorAcento}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
