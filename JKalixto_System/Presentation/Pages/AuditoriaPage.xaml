<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JKalixto_System.Presentation.ViewModels"
             xmlns:models="clr-namespace:JKalixto_System.Domain.Models"
             xmlns:controls="clr-namespace:JKalixto_System.Presentation.Controls"
             x:Class="JKalixto_System.Presentation.Pages.AuditoriaPage"
             x:DataType="vm:AuditoriaViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Reloj/fecha/tema: fila propia de ancho completo, alineada a la derecha —
             misma posición fija en TODAS las pantallas. Ver
             Presentation/Controls/BarraRelojTemaView. -->
        <controls:BarraRelojTemaView Grid.Row="0" HorizontalOptions="End" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Eventos}" EmptyView="Todavía no hay eventos registrados.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:LogAuditoria">
                    <Border BackgroundColor="{DynamicResource ColorTarjeta}"
                            Stroke="{DynamicResource ColorBorde}"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,0,0,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" BackgroundColor="{DynamicResource ColorAcento}" Padding="8,2">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                    <Label Text="{Binding TipoAccion}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource ColorFondo}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding UsuarioNombre}" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" Margin="8,0,0,0" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Timestamp, StringFormat='{0:dd/MM HH:mm}'}" FontSize="18" TextColor="{DynamicResource ColorTextoSecundario}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding Descripcion}" FontSize="21" TextColor="{DynamicResource ColorTextoPrimario}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
