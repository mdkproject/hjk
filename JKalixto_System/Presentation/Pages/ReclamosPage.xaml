<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JKalixto_System.Presentation.ViewModels"
             xmlns:services="clr-namespace:JKalixto_System.Application.Services"
             xmlns:controls="clr-namespace:JKalixto_System.Presentation.Controls"
             x:Class="JKalixto_System.Presentation.Pages.ReclamosPage"
             x:DataType="vm:ReclamosViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ColorFondo}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="14">

        <!-- Reloj/fecha/tema: fila propia de ancho completo, alineada a la derecha —
             misma posición fija en TODAS las pantallas. Ver
             Presentation/Controls/BarraRelojTemaView. -->
        <controls:BarraRelojTemaView Grid.Row="0" HorizontalOptions="End" />

        <Button Grid.Row="1"
                Text="+ Nuevo Reclamo / Queja"
                Command="{Binding NuevoReclamoCommand}"
                BackgroundColor="{DynamicResource ColorAcento}"
                TextColor="{DynamicResource ColorFondo}"
                HeightRequest="48" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Reclamos}" EmptyView="Todavía no hay reclamos ni quejas registrados.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:ReclamoCardDto">
                    <Border BackgroundColor="{DynamicResource ColorTarjeta}"
                            Stroke="{DynamicResource ColorBorde}"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReclamoTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="{DynamicResource ColorAcento}" Padding="8,2" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="5" /></Border.StrokeShape>
                                <Label Text="{Binding EtiquetaTipo}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource ColorFondo}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding NombreCompleto}" FontSize="22" FontAttributes="Bold" />
                                <Label Text="{Binding BienContratado}" FontSize="19" TextColor="{DynamicResource ColorTextoSecundario}" />
                                <Label Text="{Binding FechaTexto, StringFormat='Presentado: {0}'}" FontSize="17" TextColor="{DynamicResource ColorTextoSecundario}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2" BackgroundColor="{DynamicResource ColorBorde}" Padding="8,3" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                <Label Text="{Binding EtiquetaEstado}" FontSize="16" TextColor="{DynamicResource ColorTextoPrimario}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
