<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:JKalixto_System.Presentation.Pages"
       x:Class="JKalixto_System.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.TabBarIsVisible="False"
       Shell.NavBarIsVisible="False"
       BackgroundColor="#080C14">

    <!--
        Dos ShellContent = dos "pantallas raíz" a las que se puede navegar con
        Shell.Current.GoToAsync("//LoginPage") o "//DashboardPage".
        ContentTemplate hace que la página se cree a través del contenedor de
        inyección de dependencias (por eso LoginPage/DashboardPage pueden pedir
        su ViewModel en el constructor), siempre que estén registradas en
        MauiProgram.cs con builder.Services.AddTransient<...>().
    -->

    <ShellContent x:Name="LoginShellContent"
                  Title="Login"
                  Route="LoginPage"
                  ContentTemplate="{DataTemplate pages:LoginPage}" />

    <ShellContent x:Name="DashboardShellContent"
                  Title="Dashboard"
                  Route="DashboardPage"
                  ContentTemplate="{DataTemplate pages:DashboardPage}" />

</Shell>
