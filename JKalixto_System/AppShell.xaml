<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:JKalixto_System.Presentation.Pages"
       x:Class="JKalixto_System.AppShell"
       Shell.FlyoutBehavior="Flyout"
       FlyoutIsPresented="True"
       Shell.FlyoutWidth="230"
       Shell.TabBarIsVisible="False"
       Shell.NavBarIsVisible="True"
       FlyoutBackgroundColor="{DynamicResource ColorSuperficie}"
       BackgroundColor="{DynamicResource ColorFondo}">

    <!--
        Encabezado de la barra lateral: nombre del sistema. Sobrio, sin emojis
        (según lo pedido) — cuando haya un logo/ícono en imagen, va acá.
    -->
    <Shell.FlyoutHeader>
        <Grid Padding="22,30,22,22" BackgroundColor="{DynamicResource ColorSuperficie}">
            <VerticalStackLayout Spacing="3">
                <Label Text="HKX" FontSize="19" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="{DynamicResource ColorAcento}" />
                <Label Text="Hotel &amp; Sauna System" FontSize="11" TextColor="{DynamicResource ColorTextoSecundario}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!--
        NOTA IMPORTANTE (por qué no hay Shell.TitleView acá):
        Antes había un reloj + botón de tema puestos en Shell.TitleView. En
        Windows, esa zona es la BARRA DE TÍTULO NATIVA del sistema operativo
        (la misma franja de minimizar/maximizar/cerrar), que tiene un ancho
        fijo y limitado — Windows le mete su propio botón de "..." y corta lo
        que no entra, sin importar cómo se ajuste el layout desde MAUI. Por
        eso el reloj se veía cortado.
        El reloj y el botón de tema ahora viven DENTRO del contenido de la
        pantalla de Clientes (abajo a la derecha, como en el sistema de
        referencia), no en la barra de título de Windows.
    -->

    <!--
        Cada FlyoutItem = una pestaña de la barra lateral, ahora con ícono real
        (fuente "Segoe MDL2 Assets", nativa de Windows — no son emojis, y se
        quedan visibles aun cuando el flyout se colapsa a modo ícono con el
        botón ☰ de arriba). FlyoutIsPresented="True" arriba hace que arranque
        expandida.

        ORDEN: de arriba hacia abajo, de la pantalla que más se toca en el día a
        día de la operación (check-in/check-out, sauna, cafetería) a la que
        menos (auditoría, reportes son de uso puntual/gerencial). Registro Hotel
        es ahora la primera pestaña = la pantalla con la que arranca la app,
        reemplazando a Clientes.
    -->

    <FlyoutItem Title="Registro Hotel">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="RecepcionPage" ContentTemplate="{DataTemplate pages:RecepcionPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Registro Sauna">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE8FD;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="SaunaPage" ContentTemplate="{DataTemplate pages:SaunaPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cafetería">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BF;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="CafeteriaPage" ContentTemplate="{DataTemplate pages:CafeteriaPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Reservas">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE787;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="ReservasPage" ContentTemplate="{DataTemplate pages:ReservasPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Clientes">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="ClientesPage" ContentTemplate="{DataTemplate pages:ClientesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cierre de Caja">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="CierreCajaPage" ContentTemplate="{DataTemplate pages:CierreCajaPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Gastos">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="GastosPage" ContentTemplate="{DataTemplate pages:GastosPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Calendario">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE787;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="CalendarioPage" ContentTemplate="{DataTemplate pages:CalendarioPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Almacén">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="AlmacenPage" ContentTemplate="{DataTemplate pages:AlmacenPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Registro de Huéspedes">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE8FD;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="RegistroHuespedesPage" ContentTemplate="{DataTemplate pages:RegistroHuespedesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Libro de Reclamaciones">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="ReclamosPage" ContentTemplate="{DataTemplate pages:ReclamosPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="AuditoriaFlyoutItem" Title="Ver Auditoría">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="AuditoriaPage" ContentTemplate="{DataTemplate pages:AuditoriaPage}" />
    </FlyoutItem>

    <!-- Antes se llamaba "Panel Principal" y era la pantalla de entrada;
         ahora vive acá, como pediste, con los KPIs/gráficos que ya tenía. -->
    <FlyoutItem Title="Reportes">
        <FlyoutItem.Icon>
            <FontImageSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE734;" Color="{DynamicResource ColorTextoSecundario}" Size="20" />
        </FlyoutItem.Icon>
        <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate pages:DashboardPage}" />
    </FlyoutItem>

</Shell>
