<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>JKalixto_System.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
	</ItemGroup>

	<!-- Domain/Application/Infrastructure se movieron a librerías de clases (net10.0
	     puro, sin MAUI) — ver Migración a Web. Ahora se referencian con
	     ProjectReference normal en vez de linkear los .cs a mano; ya no hace falta
	     el rodeo de antes porque estas librerías ya no son parte de un proyecto MAUI
	     Exe. También se pudo sacar la dependencia directa de Microsoft.Maui.Graphics/
	     Controls: Servicios.cs ya no usa Color/Application.Current de MAUI (ver
	     ClaveColorEstado/ClaveColorBarra). -->
	<ItemGroup>
		<ProjectReference Include="..\JKalixto_System.Domain\JKalixto_System.Domain.csproj" />
		<ProjectReference Include="..\JKalixto_System.Application\JKalixto_System.Application.csproj" />
		<ProjectReference Include="..\JKalixto_System.Infrastructure\JKalixto_System.Infrastructure.csproj" />
	</ItemGroup>

</Project>
