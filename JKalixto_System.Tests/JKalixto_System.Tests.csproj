<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>JKalixto_System.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
		<PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.90" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
	</ItemGroup>

	<ItemGroup>
		<!-- Se referencian los archivos fuente directamente (sin ProjectReference) porque el
		     proyecto principal es una app MAUI (OutputType Exe, workloads mobile) y referenciarlo
		     como librería desde un proyecto de test es frágil. Así el test compila la MISMA
		     lógica de negocio real, sin depender del empaquetado de la app. -->
		<Compile Include="..\JKalixto_System\Domain\Models\Modelos.cs" Link="Fuente\Modelos.cs" />
		<Compile Include="..\JKalixto_System\Infrastructure\Data\AppDbContext.cs" Link="Fuente\AppDbContext.cs" />
		<Compile Include="..\JKalixto_System\Infrastructure\Data\DatosPruebaSeeder.cs" Link="Fuente\DatosPruebaSeeder.cs" />
		<Compile Include="..\JKalixto_System\Infrastructure\Repositories\Repositorios.cs" Link="Fuente\Repositorios.cs" />
		<Compile Include="..\JKalixto_System\Application\Services\Servicios.cs" Link="Fuente\Servicios.cs" />
	</ItemGroup>

</Project>
